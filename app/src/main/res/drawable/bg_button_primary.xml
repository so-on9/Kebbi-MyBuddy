<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="@color/brand_deep"
                android:endColor="@color/brand_blue"/>
            <corners android:radius="28dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="@color/brand_blue"
                android:endColor="@color/brand_deep"/>
            <corners android:radius="28dp"/>
        </shape>
    </item>
</selector>
