<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="@color/brand_deep"
                android:endColor="@color/brand_blue" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="@color/brand_blue"
                android:endColor="@color/brand_deep" />
        </shape>
    </item>
</selector>
