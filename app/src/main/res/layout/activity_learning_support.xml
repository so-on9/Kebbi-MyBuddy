<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_login_gradient"
    tools:context=".LearningSupport">

    <Button
        android:id="@+id/l_back"
        android:layout_width="92dp"
        android:layout_height="46dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_button_primary"
        android:text="返回"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/l_main"
        android:layout_width="92dp"
        android:layout_height="46dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_button_primary"
        android:text="首頁"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.cardview.widget.CardView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="32dp"
        android:layout_marginTop="74dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="24dp"
        app:cardBackgroundColor="@android:color/white"
        app:cardCornerRadius="30dp"
        app:cardElevation="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="10dp"
            android:paddingEnd="18dp"
            android:paddingBottom="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="學習支援"
                android:textColor="@color/brand_deep"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:text="選一個想練習的學習主題。"
                android:textColor="@color/text_secondary"
                android:textSize="16sp" />

            <androidx.core.widget.NestedScrollView
                android:id="@+id/scrollArea"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="16dp"
                android:layout_weight="1"
                android:fillViewport="true"
                android:scrollbars="none">

                <GridLayout
                    android:id="@+id/gridTopics"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:alignmentMode="alignMargins"
                    android:columnCount="2"
                    android:paddingBottom="12dp"
                    android:useDefaultMargins="true">

                    <LinearLayout
                        android:id="@+id/card_raise_hand"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:background="@drawable/bg_topic_card"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center"
                        android:minHeight="182dp"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <ImageView
                            android:layout_width="108dp"
                            android:layout_height="108dp"
                            android:contentDescription="上課發言"
                            android:scaleType="fitCenter"
                            android:src="@drawable/talking" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center"
                            android:text="上課發言"
                            android:textColor="@color/text_primary"
                            android:textSize="24sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/card_ask_help"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:background="@drawable/bg_topic_card"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center"
                        android:minHeight="182dp"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <ImageView
                            android:layout_width="108dp"
                            android:layout_height="108dp"
                            android:contentDescription="尋求幫助"
                            android:scaleType="fitCenter"
                            android:src="@drawable/askforhelp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center"
                            android:text="尋求幫助"
                            android:textColor="@color/text_primary"
                            android:textSize="24sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/card_conflict"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:background="@drawable/bg_topic_card"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center"
                        android:minHeight="182dp"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <ImageView
                            android:layout_width="108dp"
                            android:layout_height="108dp"
                            android:contentDescription="衝突處理"
                            android:scaleType="fitCenter"
                            android:src="@drawable/conflictresolution" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center"
                            android:text="衝突處理"
                            android:textColor="@color/text_primary"
                            android:textSize="24sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/card_meeting"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:background="@drawable/bg_topic_card"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center"
                        android:minHeight="182dp"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <ImageView
                            android:layout_width="108dp"
                            android:layout_height="108dp"
                            android:contentDescription="開會討論"
                            android:scaleType="fitCenter"
                            android:src="@drawable/meeting" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center"
                            android:text="開會討論"
                            android:textColor="@color/text_primary"
                            android:textSize="24sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </GridLayout>
            </androidx.core.widget.NestedScrollView>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
