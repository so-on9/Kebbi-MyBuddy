<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="DialogPopAnimation">
        <item name="android:windowEnterAnimation">@anim/dialog_pop_in</item>
        <item name="android:windowExitAnimation">@anim/dialog_pop_out</item>


    </style>

    <style name="BoardCell">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bg_cell_default</item>
    </style>

    <style name="BoardStamp">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:padding">10dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:src">@drawable/robot_reward</item>
    </style>

</resources>
